# =============================================================================
# Themis - AI Code Reviewer Environment Variables
# Copy this file to .env and replace placeholders with your actual credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local Docker setup runs on port 5438 by default (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/myApp?schema=public"

# -----------------------------------------------------------------------------
# Better Auth (Authentication)
# -----------------------------------------------------------------------------
# Generate a random secret string (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET="your_better_auth_secret_key_here"
# The base URL of your application
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# GitHub OAuth (User Sign-In)
# -----------------------------------------------------------------------------
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# -----------------------------------------------------------------------------
# GitHub App (PR Webhooks & Reviews)
# -----------------------------------------------------------------------------
# Create a GitHub App at https://github.com/settings/apps/new
# Webhook URL (for local dev, use an ngrok or smee.io URL): http://your-domain/api/github/webhook
# Webhook Secret: a secure random string matching GITHUB_WEBHOOK_SECRET below
# Permissions needed:
#   - Pull requests: Read & write (to post review comments)
#   - Issues: Read & write
#   - Contents: Read-only (to read repository file contents & diffs)
#   - Metadata: Read-only
# Events subscribed:
#   - Pull request (opened, synchronize, reopened)
GITHUB_APP_ID="your_github_app_numeric_id"
# Private key generated from your GitHub App settings (paste the multi-line PEM key with \n or newline)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret"
# The slug (URL-friendly name) of your GitHub App, used for the installation link
NEXT_PUBLIC_GITHUB_APP_SLUG="themis-pr-review"

# -----------------------------------------------------------------------------
# AI / LLM Provider (OpenRouter & Vercel AI SDK)
# -----------------------------------------------------------------------------
# Get an API key from https://openrouter.ai/keys
OPENROUTER_API_KEY="your_openrouter_api_key"

# -----------------------------------------------------------------------------
# Vector Database (Pinecone)
# -----------------------------------------------------------------------------
# Get an API key from https://app.pinecone.io/
# Create an index with dimension matching your embedding model (e.g. 1536 for OpenAI / compatible)
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_INDEX="themis-reviews"

# -----------------------------------------------------------------------------
# Background Jobs (Inngest)
# -----------------------------------------------------------------------------
# For local development with Inngest Dev Server (`npx inngest-cli@latest dev`),
# keys can be left empty or set to any dummy string.
# In production, get keys from https://app.inngest.com
INNGEST_EVENT_KEY="your_inngest_event_key"
INNGEST_SIGNING_KEY="your_inngest_signing_key"

# -----------------------------------------------------------------------------
# Billing (Razorpay)
# -----------------------------------------------------------------------------
# Get API keys from Razorpay Dashboard (Settings -> API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
# Secret configured in Razorpay Webhooks (pointing to /api/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
# Subscription plan ID created in Razorpay Dashboard for the Pro tier
RAZORPAY_PLAN_ID="plan_your_plan_id"

